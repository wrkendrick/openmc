<?xml version='1.0' encoding='utf-8'?>
<model>
  <materials>
    <material id="1" name="fuel" depletable="true">
      <density value="16.0" units="g/cm3"/>
      <nuclide name="U235" ao="1.0"/>
    </material>
  </materials>
  <geometry>
    <cell id="1" material="1" region="-1 -2" universe="1"/>
    <cell id="2" material="1" region="-1 2" universe="1"/>
    <surface id="1" type="sphere" boundary="vacuum" coeffs="0.0 0.0 0.0 10.0"/>
    <surface id="2" type="x-plane" coeffs="0.0"/>
  </geometry>
  <settings>
    <run_mode>eigenvalue</run_mode>
    <particles>1000</particles>
    <batches>20</batches>
    <inactive>5</inactive>
    <source type="independent" strength="1.0" particle="neutron">
      <space type="box">
        <parameters>-10.0 -10.0 -10.0 10.0 10.0 10.0</parameters>
      </space>
      <constraints>
        <fissionable>true</fissionable>
      </constraints>
    </source>
    <fission_matrix>
      <filter id="1" type="cell">
        <bins>1 2</bins>
      </filter>
      <filter id="2" type="cellborn">
        <bins>1 2</bins>
      </filter>
      <filter id="3" type="delayedgroupborn">
        <bins>0 1 2 3 4 5 6</bins>
      </filter>
    </fission_matrix>
  </settings>
  </model>
