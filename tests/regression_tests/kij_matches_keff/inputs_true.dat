  </materials>
  <geometry>
    <cell id="1" material="1" region="-1" universe="1"/>
    <cell id="2" material="2" region="1 -2" universe="1"/>
    <surface id="1" type="sphere" coeffs="0.0 0.0 0.0 16.1"/>
    <surface id="2" type="sphere" boundary="vacuum" coeffs="0.0 0.0 0.0 48.300000000000004"/>
  </geometry>
  <settings>
    <run_mode>eigenvalue</run_mode>
    <particles>2000</particles>
    <batches>100</batches>
