<?xml version='1.0' encoding='utf-8'?>
<model>
  <materials>
    <material id="1" name="fuel" depletable="true">
      <density value="10.2" units="g/cm3"/>
      <nuclide name="U235" ao="0.5"/>
      <nuclide name="U238" ao="0.5"/>
      <nuclide name="O16" ao="1.9952412"/>
      <nuclide name="O17" ao="0.000758"/>
      <nuclide name="O18" ao="0.0040008"/>
    </material>
    <material id="2" name="water">
      <density value="0.7" units="g/cm3"/>
      <nuclide name="H1" ao="1.99968852"/>
      <nuclide name="H2" ao="0.00031148"/>
      <nuclide name="O16" ao="0.9976206"/>
      <nuclide name="O17" ao="0.000379"/>
      <nuclide name="O18" ao="0.0020004"/>
      <sab name="c_H_in_H2O"/>
    </material>
  </materials>
  <geometry>
    <cell id="1" material="1" region="-1" universe="1"/>
    <cell id="2" material="1" region="1 -2" universe="1"/>
    <cell id="3" material="1" region="2 -3" universe="1"/>
    <cell id="4" material="1" region="3 -4" universe="1"/>
    <cell id="5" material="2" region="4 -5" universe="1"/>
    <surface id="1" type="sphere" coeffs="0.0 0.0 0.0 10.14236445165373"/>
    <surface id="2" type="sphere" coeffs="0.0 0.0 0.0 12.778578468344008"/>
    <surface id="3" type="sphere" coeffs="0.0 0.0 0.0 14.627820772298726"/>
    <surface id="4" type="sphere" coeffs="0.0 0.0 0.0 16.1"/>
    <surface id="5" type="sphere" boundary="vacuum" coeffs="0.0 0.0 0.0 48.300000000000004"/>
  </geometry>
  <settings>
    <run_mode>eigenvalue</run_mode>
    <particles>2000</particles>
    <batches>150</batches>
    <inactive>15</inactive>
    <source type="independent" strength="1.0" particle="neutron">
      <space type="box">
        <parameters>-16.1 -16.1 -16.1 16.1 16.1 16.1</parameters>
      </space>
      <constraints>
        <fissionable>true</fissionable>
      </constraints>
    </source>
    <fission_matrix>
      <filter id="1" type="cell">
        <bins>1 2 3 4</bins>
      </filter>
      <filter id="2" type="cellborn">
        <bins>1 2 3 4</bins>
      </filter>
      <filter id="3" type="delayedgroupborn">
        <bins>0 1 2 3 4 5 6</bins>
      </filter>
    </fission_matrix>
  </settings>
  <tallies>
    <filter id="6" type="cell">
      <bins>1</bins>
    </filter>
    <filter id="4" type="energy">
      <bins>0.0 20000000.0</bins>
    </filter>
    <filter id="5" type="delayedgroup">
      <bins>1 2 3 4 5 6</bins>
    </filter>
    <filter id="7" type="cell">
      <bins>2</bins>
    </filter>
    <filter id="8" type="cell">
      <bins>3</bins>
    </filter>
    <filter id="9" type="cell">
      <bins>4</bins>
    </filter>
    <tally id="1" name="nu-fission 1">
      <filters>6 4</filters>
      <scores>nu-fission</scores>
    </tally>
    <tally id="2" name="delayed-nu-fission 1">
      <filters>6 5 4</filters>
      <scores>delayed-nu-fission</scores>
    </tally>
    <tally id="3" name="nu-fission 2">
      <filters>7 4</filters>
      <scores>nu-fission</scores>
    </tally>
    <tally id="4" name="delayed-nu-fission 2">
      <filters>7 5 4</filters>
      <scores>delayed-nu-fission</scores>
    </tally>
    <tally id="5" name="nu-fission 3">
      <filters>8 4</filters>
      <scores>nu-fission</scores>
    </tally>
    <tally id="6" name="delayed-nu-fission 3">
      <filters>8 5 4</filters>
      <scores>delayed-nu-fission</scores>
    </tally>
    <tally id="7" name="nu-fission 4">
      <filters>9 4</filters>
      <scores>nu-fission</scores>
    </tally>
    <tally id="8" name="delayed-nu-fission 4">
